{
  "ci": {
    "collect": {
      "staticDistDir": "web/dist",
      "url": ["/", "/en/", "/es/"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "budgets": [
      {
        "path": "/*",
        "resourceSizes": [
          { "resourceType": "total", "budget": 1000000 },
          { "resourceType": "script", "budget": 300000 },
          { "resourceType": "stylesheet", "budget": 100000 },
          { "resourceType": "image", "budget": 300000 },
          { "resourceType": "font", "budget": 200000 },
          { "resourceType": "document", "budget": 100000 },
          { "resourceType": "third-party", "budget": 200000 }
        ],
        "timings": [
          { "metric": "first-contentful-paint", "budget": 2000 },
          { "metric": "largest-contentful-paint", "budget": 2500 },
          { "metric": "cumulative-layout-shift", "budget": 0.1 },
          { "metric": "total-blocking-time", "budget": 200 },
          { "metric": "speed-index", "budget": 3000 }
        ]
      }
    ],
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
