---
/**
 * Career composition — the intro and the complete employer timeline.
 *
 * Shared by `/career/` and `/es/career/`, exactly like `Home` and `Work`: the
 * page shells differ only in `locale`, `lang` and `path`, so the two locales
 * cannot drift.
 *
 * Hero-less on purpose. The hero's job on the home page is to frame the whole
 * portfolio; on this route the framing already happened, and a second hero
 * would push the first employer — the answer to "what does this person do
 * now" — below the fold. The intro is therefore the eyebrow, the page `h1`
 * and the lead, which is also what the `meta` description reuses.
 *
 * The skill matrix that follows the timeline on this route is a separate task;
 * the anchor below marks exactly where it belongs, so the next one is an
 * insertion rather than a re-layout.
 *
 * Heading order: h1 (page) → h2 (timeline) → h3 (company, from the component).
 */
import type { Copy, Locale } from '../i18n/copy';
import CareerTimeline from '../components/CareerTimeline.astro';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;
---

<section class="section" id="career" aria-labelledby="career-heading">
  <div class="shell">
    <header class="section__head reveal">
      <p class="eyebrow">{copy.career.eyebrow}</p>
      <h1 id="career-heading">{copy.career.heading}</h1>
      <p class="lead">{copy.career.summary}</p>
    </header>

    <div class="career-block">
      <h2 id="career-timeline-heading">{copy.career.timelineHeading}</h2>
      <CareerTimeline copy={copy} locale={locale} />
    </div>

    <!-- skill-matrix-slot -->
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-16) var(--space-24);
    scroll-margin-top: var(--header-height);
  }

  .section__head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  .section__head h1 {
    margin-block: var(--space-2) var(--space-3);
  }

  .career-block > h2 {
    margin-bottom: var(--space-4);
  }
</style>
