---
/**
 * Evolution composition — the complete timeline plus the legend that makes
 * each source badge readable.
 *
 * The legend is not decoration: it explains the three badges the timeline can
 * carry (curated, derived from git, snapshot), so a visitor knows that a
 * git-derived entry is an unreviewed candidate rather than curated history.
 * All four strings come from the catalog, in both locales.
 *
 * Heading order: h1 (page) → h2 (source legend, h2 timeline) → h3 (year) →
 * h4 (milestone), so no level is skipped.
 */
import type { Copy, Locale } from '../i18n/copy';
import EvolutionTimeline from '../components/EvolutionTimeline.astro';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;

const SOURCES = ['curated', 'git', 'snapshot'] as const;
---

<section class="section" id="evolution" aria-labelledby="evolution-heading">
  <div class="shell">
    <header class="section__head reveal">
      <p class="eyebrow">{copy.evolution.eyebrow}</p>
      <h1 id="evolution-heading">{copy.evolution.heading}</h1>
      <p class="lead">{copy.evolution.summary}</p>
    </header>

    <div class="source-key reveal">
      <h2 class="source-key__heading" id="source-key-heading">
        {copy.evolution.sourcesNote}
      </h2>
      <ul class="source-key__list">
        {
          SOURCES.map((source) => (
            <li class="source-key__item">
              <span class="chip chip--neutral">{copy.evolution.sourceLabel[source]}</span>
              <span class="source-key__hint">{copy.evolution.sourceHint[source]}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="timeline-block">
      <h2 id="timeline-heading">{copy.evolution.timelineHeading}</h2>
      <EvolutionTimeline copy={copy} locale={locale} />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-16) var(--space-24);
    scroll-margin-top: var(--header-height);
  }

  .section__head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  .section__head h1 {
    margin-block: var(--space-2) var(--space-3);
  }

  .source-key {
    max-width: 68ch;
    padding: var(--space-4);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .source-key__heading {
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .source-key__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .source-key__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .source-key__hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .timeline-block {
    margin-top: var(--space-12);
  }

  .timeline-block > h2 {
    margin-bottom: var(--space-4);
  }
</style>
