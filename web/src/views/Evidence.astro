---
/**
 * Evidence composition — the complete evidence list from `data/evidence.json`,
 * grouped by the status of the claim each item supports.
 *
 * The list is derived from the approved public snapshot by
 * `scripts/evidence-sync.mjs`; this view only renders it. Groups follow the
 * claim-status order (demonstrated → developing → aspirational → insufficient)
 * and empty statuses are skipped, so the page shows exactly the dataset and
 * nothing invented. A zero-item dataset renders the honest empty state.
 *
 * Every item is an external link and carries an `EvidenceBadge` whose text
 * label — not colour — states the status.
 *
 * Heading order: h1 (page) → h2 (list) → h3 (status group). Item labels are
 * not headings.
 */
import type { ClaimStatus, Copy, Locale } from '../i18n/copy';
import { evidence } from '../lib/data';
import EvidenceBadge from '../components/EvidenceBadge.astro';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { copy } = Astro.props;

/** Strongest first: a demonstrated artifact is the strongest kind of proof. */
const STATUS_ORDER: readonly ClaimStatus[] = [
  'demonstrated',
  'developing',
  'aspirational',
  'insufficient',
];

/**
 * Only statuses that actually have items are rendered, in that order. The
 * sync script emits the claim-status vocabulary, so every item lands in a
 * group; anything outside it is left out rather than mislabelled.
 */
const groups = STATUS_ORDER.map((status) => ({
  status,
  items: evidence.items.filter((item) => item.status === status),
})).filter((group) => group.items.length > 0);

const itemCount = groups.reduce((total, group) => total + group.items.length, 0);
---

<section class="section" id="evidence" aria-labelledby="evidence-heading">
  <div class="shell">
    <header class="section__head reveal">
      <p class="eyebrow">{copy.evidence.eyebrow}</p>
      <h1 id="evidence-heading">{copy.evidence.heading}</h1>
      <p class="lead">{copy.evidence.summary}</p>
      <p class="evidence__note">{copy.evidence.introNote}</p>
    </header>

    {
      itemCount === 0 ? (
        <p class="state-panel evidence__empty">{copy.evidence.empty}</p>
      ) : (
        <div class="evidence__list">
          <h2 class="evidence__list-heading" id="evidence-list-heading">
            {copy.evidence.listHeading}
          </h2>
          <p class="evidence__count tabular">{copy.evidence.count(itemCount)}</p>

          {groups.map((group) => (
            <section class="evidence-group" aria-labelledby={`evidence-status-${group.status}`}>
              <div class="evidence-group__head reveal">
                <h3 id={`evidence-status-${group.status}`}>
                  {copy.evidence.statusLabel[group.status]}
                </h3>
                <p class="evidence-group__hint">{copy.evidence.statusHint[group.status]}</p>
              </div>

              <ul class="evidence-group__items">
                {group.items.map((item) => (
                  <li class="evidence-item">
                    <EvidenceBadge status={group.status} copy={copy} label={item.label} />
                    <a
                      class="evidence-item__link"
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.url}
                      <span class="visually-hidden"> ({copy.a11y.opensInNewTab})</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-16) var(--space-24);
    scroll-margin-top: var(--header-height);
  }

  .section__head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  .section__head h1 {
    margin-block: var(--space-2) var(--space-3);
  }

  .evidence__note {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  /* The panel shape comes from the shared `.state-panel` class in global.css,
     so the empty state is visually identical to the other honest-empty states
     on the site; only the measure cap is scoped here. */
  .evidence__empty {
    max-width: 68ch;
  }

  .evidence__list-heading {
    margin-bottom: var(--space-2);
  }

  .evidence__count {
    color: var(--color-accent);
    font-size: var(--text-md);
    font-weight: 600;
  }

  .evidence-group {
    margin-top: var(--space-12);
  }

  .evidence-group__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 68ch;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .evidence-group__hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .evidence-group__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .evidence-item__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
</style>
