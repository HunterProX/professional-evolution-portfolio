---
/**
 * Ruta de evolución (es) — la línea de tiempo completa con la leyenda que
 * explica las insignias de origen (curado, derivado de git, instantánea).
 */
import type { Locale } from '../../i18n/copy';
import { getCopy } from '../../i18n/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Evolution from '../../views/Evolution.astro';

const locale: Locale = 'es';
const copy = getCopy('es');

const title = `${copy.nav.evolution} — ${copy.meta.title}`;
const description = copy.evolution.summary;
---

<BaseLayout
  locale={locale}
  lang="es"
  title={title}
  description={description}
  activeNav="evolution"
>
  <Evolution locale={locale} copy={copy} />
</BaseLayout>
