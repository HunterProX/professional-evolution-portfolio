---
/**
 * Work route (en) — all five projects from `data/projects.json`, grouped by
 * status, each card anchored with `id="<slug>"`.
 */
import type { Locale } from '../i18n/copy';
import { getCopy } from '../i18n/copy';
import BaseLayout from '../layouts/BaseLayout.astro';
import Work from '../views/Work.astro';

const locale: Locale = 'en';
const copy = getCopy(locale);

const title = `${copy.nav.work} — ${copy.meta.title}`;
const description = copy.work.summary;
---

<BaseLayout locale={locale} title={title} description={description} activeNav="projects">
  <Work locale={locale} copy={copy} />
</BaseLayout>
