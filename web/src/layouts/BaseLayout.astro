---
/**
 * Base layout — document shell, SEO metadata, pre-paint theme script,
 * landmarks and styles.
 *
 * Every page passes its locale-relative `path` (e.g. `work/`) so the canonical
 * URL, the Open Graph URL and the hreflang alternates are derived from the
 * same source: `site` + base path + locale + path. That is what keeps the
 * metadata honest on a GitHub Pages project site, where no URL may omit the
 * base path. All values come from `data/profile.json` or the copy catalog —
 * nothing is invented here.
 *
 * FOUC is avoided by resolving the theme in `<head>` before first paint: an
 * explicit choice from localStorage wins, otherwise `prefers-color-scheme`
 * decides. The same script sets `.js`, which gates the hidden initial state of
 * the reveal animation so no-JS visitors always see the content.
 *
 * The reveal observer lives here too — one copy for every route, instead of
 * one per page — and only starts on pages that actually have `.reveal` targets.
 */
import type { Copy, Locale } from '../i18n/copy';
import { getCopy } from '../i18n/copy';
import { profile } from '../lib/data';
import { route } from '../lib/urls';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  /**
   * Page part of the `<title>`; the layout appends " — <profile name>".
   * Omitted on home, which uses the full default title from the catalog.
   */
  title?: string;
  description?: string;
  /** Open Graph content type; `article` for case studies, `website` elsewhere. */
  ogType?: 'website' | 'article';
  /** Locale-relative path of this page, e.g. `work/` or `work/<slug>/`. */
  path?: string;
  /** Copy locale; also the document language unless `lang` overrides it. */
  locale?: Locale;
  /** `<html lang>`; defaults to the copy locale, i.e. `en` on English pages. */
  lang?: Locale;
  /** Footer slot for the public snapshot identifier. */
  snapshotId?: string;
  /** Marks the currently visible home section for the nav indicator. */
  activeNav?: 'projects' | 'evolution' | 'evidence' | 'contact';
  /** JSON-LD blocks; the home pages pass the Person entity (see lib/seo.ts). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogType = 'website',
  path = '',
  locale = 'en',
  lang,
  snapshotId,
  activeNav,
  jsonLd = [],
} = Astro.props;

const copy: Copy = getCopy(locale);
const documentTitle = title ? `${title} — ${profile.name}` : copy.meta.title;
const metaDescription = description ?? copy.meta.description;

/* Canonical and alternates: `site` + base + locale + path, never the bare
   path — the deployment lives under a base path. Both locales have every
   route, so the alternates always resolve; `x-default` points at English. */
const canonical = Astro.site ? new URL(route(locale, path), Astro.site) : undefined;
const alternateEn = Astro.site ? new URL(route('en', path), Astro.site) : undefined;
const alternateEs = Astro.site ? new URL(route('es', path), Astro.site) : undefined;
const ogLocale = locale === 'es' ? 'es_ES' : 'en_US';
const faviconHref = `${import.meta.env.BASE_URL}favicon.svg`;
---

<!doctype html>
<html lang={lang ?? locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {
      alternateEn && alternateEs && (
        <>
          <link rel="alternate" hreflang="en" href={alternateEn.href} />
          <link rel="alternate" hreflang="es" href={alternateEs.href} />
          <link rel="alternate" hreflang="x-default" href={alternateEn.href} />
        </>
      )
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={metaDescription} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:locale" content={ogLocale} />
    <meta
      property="og:locale:alternate"
      content={locale === 'es' ? 'en_US' : 'es_ES'}
    />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let stored = null;
        try {
          stored = localStorage.getItem('pep-theme');
        } catch {
          /* storage unavailable: fall through to the OS preference */
        }
        const preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        root.dataset.theme = stored === 'light' || stored === 'dark' ? stored : preferred;
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{copy.a11y.skipToContent}</a>

    <Header copy={copy} locale={locale} active={activeNav} />

    <main id="main">
      <slot />
    </main>

    <Footer copy={copy} snapshotId={snapshotId} />

    <script is:inline>
      // Reveal-on-scroll: one pass over the page, no framework. It only starts
      // when the page has `.reveal` targets, and the hidden initial state lives
      // behind `.js`, so this script only ever adds a class, never removes
      // content.
      //
      // Two thresholds, because a single percentage threshold cannot serve both
      // a card and a full-page section. `threshold: 0.15` means "15% of the
      // element must be visible", but an element taller than roughly 6.7
      // viewports can never reach that ratio — the evolution timeline is about
      // 7800px tall in a 720px viewport, so its ceiling is ~9% and it would
      // stay permanently at opacity 0 with JavaScript enabled. Targets taller
      // than the viewport are therefore revealed as soon as any part of them
      // intersects; shorter ones keep 15% so a single sliver of a card is not
      // enough to reveal it.
      (() => {
        const targets = document.querySelectorAll('.reveal');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!targets.length || reduced || !('IntersectionObserver' in window)) {
          targets.forEach((target) => target.classList.add('is-visible'));
          return;
        }

        const short = [];
        const tall = [];
        for (const target of targets) {
          const group = target.getBoundingClientRect().height > window.innerHeight ? tall : short;
          group.push(target);
        }

        for (const [group, threshold] of [[short, 0.15], [tall, 0]]) {
          if (!group.length) continue;
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            },
            { threshold, rootMargin: '0px 0px -12% 0px' },
          );
          group.forEach((target) => observer.observe(target));
        }
      })();
    </script>
  </body>
</html>