---
/**
 * Base layout — document shell, pre-paint theme script, landmarks and styles.
 *
 * FOUC is avoided by resolving the theme in `<head>` before first paint: an
 * explicit choice from localStorage wins, otherwise `prefers-color-scheme`
 * decides. The same script sets `.js`, which gates the hidden initial state of
 * the reveal animation so no-JS visitors always see the content.
 *
 * The reveal observer lives here too — one copy for every route, instead of
 * one per page — and only starts on pages that actually have `.reveal` targets.
 */
import type { Copy, Locale } from '../i18n/copy';
import { getCopy } from '../i18n/copy';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Copy locale; also the document language unless `lang` overrides it. */
  locale?: Locale;
  /** `<html lang>`; defaults to the copy locale, i.e. `en` on English pages. */
  lang?: Locale;
  /** Footer slot for the public snapshot identifier. */
  snapshotId?: string;
  /** Marks the currently visible home section for the nav indicator. */
  activeNav?: 'projects' | 'evolution' | 'evidence' | 'contact';
}

const {
  title,
  description,
  locale = 'en',
  lang,
  snapshotId,
  activeNav,
} = Astro.props;

const copy: Copy = getCopy(locale);
const documentTitle = title ?? copy.meta.title;
const metaDescription = description ?? copy.meta.description;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang ?? locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={metaDescription} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={metaDescription} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:locale" content={locale} />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let stored = null;
        try {
          stored = localStorage.getItem('pep-theme');
        } catch {
          /* storage unavailable: fall through to the OS preference */
        }
        const preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        root.dataset.theme = stored === 'light' || stored === 'dark' ? stored : preferred;
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{copy.a11y.skipToContent}</a>

    <Header copy={copy} locale={locale} active={activeNav} />

    <main id="main">
      <slot />
    </main>

    <Footer copy={copy} snapshotId={snapshotId} />

    <script is:inline>
      // Reveal-on-scroll: one pass over the page, no framework. It only starts
      // when the page has `.reveal` targets, and the hidden initial state lives
      // behind `.js`, so this script only ever adds a class, never removes
      // content.
      //
      // Two thresholds, because a single percentage threshold cannot serve both
      // a card and a full-page section. `threshold: 0.15` means "15% of the
      // element must be visible", but an element taller than roughly 6.7
      // viewports can never reach that ratio — the evolution timeline is about
      // 7800px tall in a 720px viewport, so its ceiling is ~9% and it would
      // stay permanently at opacity 0 with JavaScript enabled. Targets taller
      // than the viewport are therefore revealed as soon as any part of them
      // intersects; shorter ones keep 15% so a single sliver of a card is not
      // enough to reveal it.
      (() => {
        const targets = document.querySelectorAll('.reveal');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!targets.length || reduced || !('IntersectionObserver' in window)) {
          targets.forEach((target) => target.classList.add('is-visible'));
          return;
        }

        const short = [];
        const tall = [];
        for (const target of targets) {
          const group = target.getBoundingClientRect().height > window.innerHeight ? tall : short;
          group.push(target);
        }

        for (const [group, threshold] of [[short, 0.15], [tall, 0]]) {
          if (!group.length) continue;
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            },
            { threshold, rootMargin: '0px 0px -12% 0px' },
          );
          group.forEach((target) => observer.observe(target));
        }
      })();
    </script>
  </body>
</html>