{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/portfolio/public-snapshot/schema.json",
  "title": "Public portfolio evidence snapshot",
  "description": "Conservative, machine-readable snapshot of public portfolio evidence. The schema exists to make over-claiming structurally hard: claim status is mandatory, demonstrated claims require at least one public https evidence URL, and goals cannot carry dates or numeric metrics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "snapshot_id",
    "generated_at",
    "snapshot_status",
    "requires_human_review",
    "purpose",
    "exclusions",
    "identity",
    "claim_status_semantics",
    "claims",
    "evidence",
    "projects",
    "goals",
    "disclaimers"
  ],
  "properties": {
    "$schema": {
      "description": "Relative reference to this schema file. Allowed here as the only non-public path in the document.",
      "type": "string",
      "const": "./schema.json"
    },
    "schema_version": {
      "description": "Semantic version of this snapshot format. Only bumped by a human.",
      "type": "string",
      "const": "1.0.0"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "generated_at": {
      "description": "Generation timestamp. This is the only date in the document and it is machine-set, never estimated.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "snapshot_status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved"
      ]
    },
    "requires_human_review": {
      "description": "Always true for a machine-generated snapshot.",
      "type": "boolean",
      "const": true
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "claim_status_semantics": {
      "description": "Human-readable definitions of each claim status, so the vocabulary cannot drift silently.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demonstrated",
        "developing",
        "aspirational",
        "insufficient_evidence"
      ],
      "properties": {
        "demonstrated": {
          "type": "string",
          "minLength": 10
        },
        "developing": {
          "type": "string",
          "minLength": 10
        },
        "aspirational": {
          "type": "string",
          "minLength": 10
        },
        "insufficient_evidence": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "goals": {
      "$ref": "#/$defs/goals"
    },
    "disclaimers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "$defs": {
    "publicHttpsUrl": {
      "description": "Absolute, public, https URL. http, localhost, loopback, link-local and RFC1918 hosts, and private/relative paths are rejected by the validator.",
      "type": "string",
      "pattern": "^https://[^\\s/?#]+(?:[/?#][^\\s]*)?$"
    },
    "idPrefixRef": {
      "description": "Reference to an existing entry id. Resolution is enforced by the validator, not by JSON Schema.",
      "type": "string",
      "minLength": 3
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "professional_name",
        "positioning",
        "positioning_status",
        "positioning_notes",
        "public_urls"
      ],
      "properties": {
        "professional_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "positioning": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "positioning_status": {
          "type": "string",
          "enum": [
            "aspirational",
            "developing",
            "demonstrated"
          ]
        },
        "positioning_notes": {
          "type": "string",
          "minLength": 10
        },
        "public_urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/publicHttpsUrl"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "category",
        "status",
        "evidence_refs",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^claim-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "text": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400
        },
        "category": {
          "type": "string",
          "enum": [
            "capability",
            "direction",
            "project",
            "negative"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "demonstrated",
            "developing",
            "aspirational",
            "insufficient_evidence"
          ]
        },
        "evidence_refs": {
          "description": "Ids of evidence entries. Must be empty unless status is 'demonstrated'.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/idPrefixRef"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "url",
        "public",
        "verification_status",
        "supports_claims",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "professional_profile",
            "code_repository",
            "live_demo",
            "publication",
            "certificate",
            "employer_attestation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "url": {
          "$ref": "#/$defs/publicHttpsUrl"
        },
        "public": {
          "description": "Must be true. Private or unlisted artifacts are not admissible evidence.",
          "type": "boolean",
          "const": true
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified_independent",
            "verified_self_reported",
            "unverified_self_reported"
          ]
        },
        "supports_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/idPrefixRef"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "maturity",
        "public",
        "public_urls",
        "evidence_level",
        "claim_refs",
        "capabilities_demonstrated",
        "capabilities_not_demonstrated",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^proj-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "in_progress_prototype",
            "in_progress",
            "released"
          ]
        },
        "maturity": {
          "type": "string",
          "enum": [
            "not_started",
            "prototype",
            "alpha",
            "beta",
            "released"
          ]
        },
        "public": {
          "type": "boolean"
        },
        "public_urls": {
          "description": "Must be empty while 'public' is false.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicHttpsUrl"
          }
        },
        "evidence_level": {
          "description": "Same vocabulary as claim status.",
          "type": "string",
          "enum": [
            "demonstrated",
            "developing",
            "aspirational",
            "insufficient_evidence"
          ]
        },
        "claim_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/idPrefixRef"
          }
        },
        "capabilities_demonstrated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "capabilities_not_demonstrated": {
          "description": "Must be non-empty for prototype and below, to keep the gaps explicit.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "notes": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "short",
        "medium",
        "long"
      ],
      "properties": {
        "short": {
          "$ref": "#/$defs/goal"
        },
        "medium": {
          "$ref": "#/$defs/goal"
        },
        "long": {
          "$ref": "#/$defs/goal"
        }
      }
    },
    "goal": {
      "description": "Goals are drafts. Target dates, deadlines and numeric metrics are not representable in this schema on purpose.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizon",
        "status",
        "requires_human_review",
        "statement",
        "success_criteria",
        "open_questions"
      ],
      "properties": {
        "horizon": {
          "type": "string",
          "enum": [
            "short",
            "medium",
            "long"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "requires_human_review"
          ]
        },
        "requires_human_review": {
          "type": "boolean",
          "const": true
        },
        "statement": {
          "type": "string",
          "minLength": 20,
          "maxLength": 400
        },
        "success_criteria": {
          "description": "Deliberately an empty list in draft. Populated only by a human.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    }
  }
}