{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/portfolio/github-activity/schema.json",
  "title": "Public GitHub activity snapshot",
  "description": "Build-time, allowlisted public GitHub activity. It is not a live contribution feed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "captured_at", "status", "source", "allowed_repositories", "repositories"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "snapshot_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "captured_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "status": { "type": "object", "additionalProperties": false, "required": ["availability", "stale", "message"], "properties": { "availability": { "enum": ["available", "empty", "unavailable"] }, "stale": { "type": "boolean" }, "message": { "type": "string", "minLength": 10 } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["provider", "mode", "url"], "properties": { "provider": { "const": "github" }, "mode": { "enum": ["checked_in_fixture", "build_snapshot"] }, "url": { "type": "string", "pattern": "^https://github\\.com/?$" } } },
    "allowed_repositories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/githubUrl" }, "uniqueItems": true },
    "repositories": { "type": "array", "items": { "$ref": "#/$defs/repository" } }
  },
  "$defs": {
    "githubUrl": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$" },
    "object": { "type": "object", "additionalProperties": false, "required": ["id", "url", "captured_at", "title"], "properties": { "id": { "type": "string", "minLength": 2, "pattern": "^[A-Za-z0-9._-]+$" }, "url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(?:pull|commit|releases/tag|deployments)/[^\\s]+$" }, "captured_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }, "title": { "type": "string", "minLength": 2, "maxLength": 200 } } },
    "repository": { "type": "object", "additionalProperties": false, "required": ["id", "url", "visibility", "pull_requests", "commits", "releases", "deployments"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }, "url": { "$ref": "#/$defs/githubUrl" }, "visibility": { "const": "public" }, "pull_requests": { "type": "array", "items": { "$ref": "#/$defs/object" } }, "commits": { "type": "array", "items": { "$ref": "#/$defs/object" } }, "releases": { "type": "array", "items": { "$ref": "#/$defs/object" } }, "deployments": { "type": "array", "items": { "$ref": "#/$defs/object" } } } }
  }
}
